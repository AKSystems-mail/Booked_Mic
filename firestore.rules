rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isListOwner(listId) {
      let listDoc = get(/databases/$(database)/documents/Lists/$(listId));
      return isAuthenticated() && listDoc.data != null && listDoc.data.userId == request.auth.uid;
    }

    function isGuestHost(listId) {
      let listDoc = get(/databases/$(database)/documents/Lists/$(listId));
      return isAuthenticated() && listDoc.data != null && 
             listDoc.data.guestHostUserId == request.auth.uid && 
             listDoc.data.guestHostEnabled == true;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isNotChangingCoreData(request, resource) {
      return request.resource.data.userId == resource.data.userId &&
             (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
             request.resource.data.listName == resource.data.listName &&
             request.resource.data.numberOfSpots == resource.data.numberOfSpots;
    }
    // --- End Helper Functions ---

    // --- Admins Collection ---
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false; 
    }

    // --- Lists Collection ---
    match /Lists/{listId} {
      allow list, read: if isAuthenticated() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Allow updates if:
      // 1. User is Admin
      // 2. User is Owner
      // 3. User is Guest Host
      // 4. User is a Performer signing up (only allowed to change spots/signedUpUserIds)
      allow update: if isAdmin() || isListOwner(listId) || isGuestHost(listId) || 
                      (isAuthenticated() && isNotChangingCoreData(request, resource));

      allow delete: if isAdmin() || isListOwner(listId);

      // --- Rules for bucketSignups subcollection ---
      match /bucketSignups/{signupUserId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && request.auth.uid == signupUserId;
        allow update: if isAdmin() || isListOwner(listId) || isGuestHost(listId);
      }
    }

    // --- Collection Group Rule for bucketSignups ---
    match /{path=**}/bucketSignups/{signupDocId} {
      allow read: if isAuthenticated();
    }
    
    // --- Client Logs (diagnostics) ---
    match /client_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, list: if isAdmin();
      allow update, delete: if false;
    }

    // --- Diagnostics (pinned per-user, per-list snapshots) ---
    match /diagnostics/{uid}/snapshots/{listId} {
      allow read, list: if isAdmin();
      allow write: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if false;
    }
  }
}
